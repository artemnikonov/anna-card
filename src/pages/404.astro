---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout title="404 — Page not found | Anna Zakernichnaia" description="Page not found" noindex>
  <section class="container mx-auto px-4 py-24 text-center max-w-2xl">
    <h1 class="text-4xl font-heading font-bold text-gray-800 mb-6">404</h1>
    <p class="text-lg text-gray-600 mb-2">Page not found.</p>
    <p class="text-lg text-gray-600 mb-8" lang="ru">Страница не найдена.</p>
    <div class="flex gap-4 justify-center">
      <a href="/" class="text-primary underline">Home</a>
      <a href="/ru/" class="text-primary underline" lang="ru">На главную</a>
    </div>
  </section>
</MainLayout>
