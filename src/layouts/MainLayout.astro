---
import '@/styles/global.css';
import '@/styles/fonts.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/layout/Header';
import Footer from '@/components/layout/Footer';
import { getLocaleFromUrl } from '@/lib/i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonical?: string;
}

const locale = getLocaleFromUrl(Astro.url);

const defaultKeywords = locale === 'ru'
  ? 'коррекция осанки Лимассол, работа с телом Кипр, улучшение подвижности, wellness Кипр, Лимассол'
  : 'posture correction Limassol, movement coaching Cyprus, bodywork, wellness Cyprus, Limassol';

const {
  title = locale === 'ru'
    ? 'Коррекция осанки и работа с телом в Лимассоле | Анна Закерничная'
    : 'Posture & Movement Coaching in Limassol, Cyprus | Anna Zakernichnaia',
  description = locale === 'ru'
    ? 'Профессиональная работа с телом в Лимассоле, Кипр. Индивидуальные сеансы для улучшения осанки и подвижности.'
    : 'Professional posture and movement coaching in Limassol, Cyprus. Private sessions for posture improvement and mobility.',
  keywords = defaultKeywords,
  image = '/images/og-image.webp',
  canonical = Astro.url.pathname
} = Astro.props;

const canonicalURL = new URL(canonical, Astro.site);
const imageURL = new URL(image, Astro.site);

// Hreflang URLs for multilingual SEO
const currentPath = Astro.url.pathname;
const isRussian = currentPath.startsWith('/ru');
const basePath = isRussian ? currentPath.replace(/^\/ru/, '') || '/' : currentPath;
const enURL = new URL(basePath, Astro.site);
const ruURL = new URL(`/ru${basePath === '/' ? '' : basePath}`, Astro.site);

// JSON-LD Structured Data
const baseJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Anna Zakernichnaia - Posture & Movement Coach",
  "description": locale === 'ru'
    ? "Профессиональная коррекция осанки и работа с телом в Лимассоле, Кипр"
    : "Professional posture and movement coaching in Limassol, Cyprus",
  "url": "https://annabody.studio",
  "image": "https://annabody.studio/images/og-image.webp",
  "telephone": "+79267291313",
  "email": "ann.massage@icloud.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Limassol",
    "addressCountry": "CY"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "34.7071",
    "longitude": "33.0226"
  },
  "priceRange": "$$",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "09:00",
    "closes": "20:00"
  },
  "sameAs": [
    "https://t.me/AnnaZakernichnaia",
    "https://www.instagram.com/annabody.studio"
  ]
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5F9EA0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang for multilingual SEO -->
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="ru" href={ruURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />

    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="//static.parastorage.com" />
    <link rel="preconnect" href="//static.parastorage.com" crossorigin />

    <!-- Preload Montserrat font to prevent FOUT -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="//static.parastorage.com/tag-bundler/api/v1/fonts-cache/googlefont/woff2/s/montserrat/v14/JTUSjIg1_i6t8kCHKm459WlhyyTh89Y.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="//static.parastorage.com/tag-bundler/api/v1/fonts-cache/googlefont/woff2/s/montserrat/v14/JTUSjIg1_i6t8kCHKm459W1hyyTh89ZNpQ.woff2" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />

    <!-- Additional SEO -->
    <meta name="author" content="Anna Zakernichnaia" />
    <meta name="keywords" content={keywords} />

    <slot name="head" />
    <ClientRouter />

    <!-- Umami Analytics -->
    <script
      is:inline
      defer
      src="/stats/script.js"
      data-website-id="bbf062e9-7570-4278-ba92-ca68c381f42d"
    ></script>

    <script is:inline>
      if (!window.__astroScrollToTopInitialized) {
        window.__astroScrollToTopInitialized = true;
        document.addEventListener('astro:after-swap', () => {
          window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
        });
      }
    </script>

    <style is:inline>
      html {
        background-color: #FFFFFF;
      }

      body {
        background-color: #FFFFFF;
        display: block !important;
      }

      /* Disable view transition animations to prevent flickering */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none !important;
      }

      /* Prevent any flash during navigation */
      ::view-transition-group(root) {
        animation-duration: 0s !important;
      }

      header {
        position: fixed;
        z-index: 50;
      }

      .page-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .page-shell main {
        flex: 1;
      }

    </style>



  </head>
  <body>
    <div class="page-shell min-h-screen bg-white flex flex-col">
      <div transition:persist="header">
        <Header client:idle />
      </div>

      <main class="pt-20 flex-1 min-h-[60vh]">
        <slot />
      </main>

      <div transition:persist="footer">
        <Footer client:idle />
      </div>
    </div>

  </body>
</html>

