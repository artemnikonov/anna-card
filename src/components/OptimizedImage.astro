---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  format?: 'avif' | 'webp' | 'jpeg' | 'png';
  quality?: number;
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  format = 'webp',
  quality = 80
} = Astro.props;

const isLocalImage = typeof src !== 'string' || src.startsWith('/');
---

{isLocalImage && typeof src !== 'string' ? (
  <Image
    src={src as ImageMetadata}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={loading}
    format={format}
    quality={quality}
  />
) : (
  <img
    src={typeof src === 'string' ? src : ''}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={loading}
  />
)}

