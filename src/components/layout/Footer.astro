---
import { Camera, Mail, MapPin, MessageCircle, Send } from '@lucide/astro';
import { getLocalizedPath, getTranslations, type Locale } from '@/lib/i18n';
import { baseNavigation } from '@/lib/navigation';
import { CONTACTS } from '@/lib/contacts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getTranslations(locale);
const navigation = baseNavigation.map((item) => ({
  name: t.nav[item.key],
  href: getLocalizedPath(item.path, locale),
}));
const year = new Date().getFullYear();
---
<footer class="bg-gray-900 text-white py-12 sm:py-16">
  <div class="container mx-auto px-4 sm:px-6 max-w-[100rem]">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      <div class="lg:col-span-2">
        <div class="flex items-center space-x-2 sm:space-x-3 mb-6">
          <div class="w-10 sm:w-12 h-10 sm:h-12 bg-primary rounded-full flex items-center justify-center shrink-0">
            <span class="text-white font-heading font-bold text-lg sm:text-xl">AZ</span>
          </div>
          <div class="min-w-0">
            <div class="font-heading font-bold text-white text-base sm:text-xl">
              {t.common.name} — {t.common.tagline}
            </div>
            <div class="font-paragraph text-gray-300 text-xs sm:text-sm">
              {t.homepage.heroTitle}
            </div>
          </div>
        </div>
        <p class="font-paragraph text-gray-300 leading-relaxed max-w-md">
          {t.footer.description}
        </p>
      </div>

      <div>
        <h2 class="font-heading font-semibold text-white mb-4">{t.footer.quickLinks}</h2>
        <ul class="space-y-2">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-paragraph text-gray-300 hover:text-white transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="font-heading font-semibold text-white mb-4">{t.contact.contactInfo}</h2>
        <div class="space-y-3">
          <div class="flex items-start space-x-3">
            <MapPin class="w-5 h-5 text-primary mt-0.5" />
            <div>
              <p class="font-paragraph text-gray-300">{t.contact.locationValue}</p>
            </div>
          </div>
          <a
            href={CONTACTS.telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-3 text-gray-300 hover:text-white transition-colors"
            aria-label={`Telegram: ${CONTACTS.telegramHandle}`}
          >
            <Send class="w-5 h-5 text-primary" />
            <span class="font-paragraph">{CONTACTS.telegramHandle}</span>
          </a>
          <a
            href={CONTACTS.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-3 text-gray-300 hover:text-white transition-colors"
            aria-label={`WhatsApp: ${CONTACTS.phoneDisplay}`}
          >
            <MessageCircle class="w-5 h-5 text-primary" />
            <span class="font-paragraph">{t.contact.phoneValue}</span>
          </a>
          <a
            href={`mailto:${CONTACTS.email}`}
            class="flex items-center space-x-3 text-gray-300 hover:text-white transition-colors"
            aria-label={`Email: ${CONTACTS.email}`}
          >
            <Mail class="w-5 h-5 text-primary" />
            <span class="font-paragraph">{t.contact.emailValue}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-12 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <p class="font-paragraph text-gray-400 text-sm mb-4 md:mb-0">
          © {year} {t.common.name} — {t.common.tagline}
        </p>
        <div class="flex items-center space-x-4">
          <a
            href={CONTACTS.telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-primary transition-colors"
            aria-label="Telegram"
          >
            <Send class="w-5 h-5" />
          </a>
          <a
            href={CONTACTS.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-primary transition-colors"
            aria-label="WhatsApp"
          >
            <MessageCircle class="w-5 h-5" />
          </a>
          <a
            href={CONTACTS.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-primary transition-colors"
            aria-label="Instagram"
          >
            <Camera class="w-5 h-5" />
          </a>
          <a
            href={`mailto:${CONTACTS.email}`}
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-primary transition-colors"
            aria-label="Email"
          >
            <Mail class="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
