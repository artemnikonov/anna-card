---
import PageHero from '@/components/PageHero.astro';
import { CONTACTS } from '@/lib/contacts';
import { getLocaleFromUrl, getTranslations } from '@/lib/i18n';
import AnimatedSection from '@/components/ui/AnimatedSection.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { MapPin, Mail, Camera, MessageCircle, Clock, Send } from '@lucide/astro';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

const faqs = [
  { question: t.contact.faq1Q, answer: t.contact.faq1A },
  { question: t.contact.faq5Q, answer: t.contact.faq5A },
  { question: t.contact.faq2Q, answer: t.contact.faq2A },
  { question: t.contact.faq3Q, answer: t.contact.faq3A },
  { question: t.contact.faq4Q, answer: t.contact.faq4A }
];
---

<div class="min-h-screen bg-white overflow-x-hidden">
  <PageHero title={t.contact.title} subtitle={t.contact.subtitle} />

  <!-- Contact Methods -->
  <section class="py-12 sm:py-16 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-12 sm:mb-16">
        <!-- Telegram - Primary -->
        <AnimatedSection animation="fadeUp" delay={0}>
          <div class={cn("rounded-xl border border-foreground/10 text-foreground bg-background", "text-center hover:shadow-lg transition-shadow duration-300 h-full border-2 border-primary")}>
            <div class={cn("p-6 pt-0", "p-6")}>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <Send class="w-8 h-8 text-primary" />
              </div>
              <h2 class="text-lg font-heading font-bold text-gray-800 mb-1.5">
                Telegram
              </h2>
              <p class="text-xs font-paragraph text-gray-500 mb-2">
                {t.contact.telegramDesc}
              </p>
              <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ size: 'sm' }), 'bg-primary hover:bg-primary/90 text-white')}>{t.contact.messageOnTelegram}</a>
            </div>
          </div>
        </AnimatedSection>

        <!-- WhatsApp - Alternative Primary -->
        <AnimatedSection animation="fadeUp" delay={0.1}>
          <div class={cn("rounded-xl border border-foreground/10 text-foreground bg-background", "text-center hover:shadow-lg transition-shadow duration-300 h-full")}>
            <div class={cn("p-6 pt-0", "p-6")}>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <MessageCircle class="w-8 h-8 text-primary" />
              </div>
              <h2 class="text-lg font-heading font-bold text-gray-800 mb-1.5">
                WhatsApp
              </h2>
              <p class="text-xs font-paragraph text-gray-500 mb-2">
                {t.contact.whatsappDesc}
              </p>
              <a href={CONTACTS.whatsapp} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'border-primary text-primary hover:bg-primary/5')}>{t.contact.messageOnWhatsapp}</a>
            </div>
          </div>
        </AnimatedSection>

        <!-- Instagram -->
        <AnimatedSection animation="fadeUp" delay={0.2}>
          <div class={cn("rounded-xl border border-foreground/10 text-foreground bg-background", "text-center hover:shadow-lg transition-shadow duration-300 h-full")}>
            <div class={cn("p-6 pt-0", "p-6")}>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <Camera class="w-8 h-8 text-primary" />
              </div>
              <h2 class="text-lg font-heading font-bold text-gray-800 mb-1.5">
                Instagram
              </h2>
              <p class="text-xs font-paragraph text-gray-500 mb-2">
                {t.contact.instagramDesc}
              </p>
              <a href={CONTACTS.instagram} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'border-primary text-primary hover:bg-primary/5')}>{t.contact.followOnInstagram}</a>
            </div>
          </div>
        </AnimatedSection>

        <!-- Email - Last Resort -->
        <AnimatedSection animation="fadeUp" delay={0.3}>
          <div class={cn("rounded-xl border border-foreground/10 text-foreground bg-background", "text-center hover:shadow-lg transition-shadow duration-300 h-full")}>
            <div class={cn("p-6 pt-0", "p-6")}>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <Mail class="w-8 h-8 text-primary" />
              </div>
              <h2 class="text-lg font-heading font-bold text-gray-800 mb-1.5">
                Email
              </h2>
              <p class="text-xs font-paragraph text-gray-500 mb-2">
                {t.contact.emailDesc}
              </p>
              <a href={`mailto:${CONTACTS.email}`} class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'border-primary text-primary hover:bg-primary/5')}>{t.contact.sendEmail}</a>
            </div>
          </div>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="py-12 sm:py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Contact Information -->
        <AnimatedSection animation="fadeUp">
          <div class={cn("rounded-xl border border-foreground/10 text-foreground bg-background", "h-full")}>
            <div class="flex flex-col space-y-1.5 p-6">
              <h2 class={cn("font-semibold text-lg leading-none tracking-tight", "text-2xl font-heading font-bold text-gray-800")}>
                {t.contact.contactInformation}
              </h2>
            </div>
            <div class={cn("p-6 pt-0", "space-y-6")}>
              <div class="flex items-start gap-4">
                <MapPin class="w-6 h-6 text-primary mt-1 shrink-0" />
                <div>
                  <h3 class="font-heading font-semibold text-gray-800 mb-1">{t.contact.location}</h3>
                  <p class="font-paragraph text-blue-gray">
                    {t.contact.locationValue}
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <MessageCircle class="w-6 h-6 text-primary mt-1 shrink-0" />
                <div>
                  <h3 class="font-heading font-semibold text-gray-800 mb-1">WhatsApp</h3>
                  <p class="font-paragraph text-blue-gray">{t.contact.phoneValue}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <Send class="w-6 h-6 text-primary mt-1 shrink-0" />
                <div>
                  <h3 class="font-heading font-semibold text-gray-800 mb-1">Telegram</h3>
                  <p class="font-paragraph text-blue-gray">{CONTACTS.telegramHandle}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <Mail class="w-6 h-6 text-primary mt-1 shrink-0" />
                <div>
                  <h3 class="font-heading font-semibold text-gray-800 mb-1">{t.contact.emailLabel}</h3>
                  <p class="font-paragraph text-blue-gray">{t.contact.emailValue}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <Clock class="w-6 h-6 text-primary mt-1 shrink-0" />
                <div>
                  <h3 class="font-heading font-semibold text-gray-800 mb-1">{t.contact.responseTime}</h3>
                  <p class="font-paragraph text-blue-gray">
                    {t.contact.responseTimeValue}<br />
                    <span class="text-sm">{t.contact.emergencyConsultations}</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </AnimatedSection>

        <!-- Movement Studio -->
        <AnimatedSection animation="fadeUp" delay={0.1}>
          <div class={cn("rounded-xl border border-foreground/10 text-foreground bg-background", "h-full")}>
            <div class={cn("p-6 pt-0", "p-0")}>
              <img
                src="/images/contact/recovery-studio.webp"
                alt={t.images.studio}
                width="600"
                class="w-full h-64 object-cover rounded-t-lg select-none"
                loading="lazy"
                decoding="async"
              />
              <div class="p-6">
                <h2 class="text-2xl font-heading font-bold text-gray-800 mb-4">
                  {t.contact.recoveryStudio}
                </h2>
                <p class="font-paragraph text-blue-gray">
                  {t.contact.recoveryStudioDesc}
                </p>
              </div>
            </div>
          </div>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection animation="fadeUp">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-4 sm:mb-6 leading-tight">
            {t.contact.faqTitle}
          </h2>
          <p class="text-base sm:text-lg font-paragraph text-blue-gray max-w-3xl mx-auto px-4 leading-relaxed">
            {t.contact.faqSubtitle}
          </p>
        </div>
      </AnimatedSection>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 max-w-6xl mx-auto">
        {faqs.map((faq, index) => (
          <AnimatedSection animation="fadeUp" delay={index * 0.1}>
            <div class="rounded-xl border border-foreground/10 text-foreground bg-background">
              <div class={cn("p-6 pt-0", "p-6")}>
                <h3 class="font-heading font-semibold text-gray-800 mb-3">
                  {faq.question}
                </h3>
                <p class="font-paragraph text-blue-gray leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            </div>
          </AnimatedSection>
        ))}
      </div>
    </div>
  </section>
</div>
