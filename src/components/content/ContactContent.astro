---
import { getLocaleFromUrl, getTranslations } from '@/lib/i18n';
import { AnimatedSection } from '@/components/ui/AnimatedSection';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { MapPin, Mail, Camera, MessageCircle, Clock, Send } from 'lucide-react';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

const faqs = [
  { question: t.contact.faq1Q, answer: t.contact.faq1A },
  { question: t.contact.faq2Q, answer: t.contact.faq2A },
  { question: t.contact.faq3Q, answer: t.contact.faq3A },
  { question: t.contact.faq4Q, answer: t.contact.faq4A }
];
---

<div class="min-h-screen bg-white overflow-x-hidden">
  <!-- Header -->
  <section class="py-16 sm:py-20 md:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection client:visible animation="fadeUp">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-gray-800 mb-4 sm:mb-6 leading-tight">
            {t.contact.title}
          </h1>
          <p class="text-base sm:text-lg md:text-xl font-paragraph text-blue-gray max-w-3xl mx-auto px-4 leading-relaxed">
            {t.contact.subtitle}
          </p>
        </div>
      </AnimatedSection>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="py-12 sm:py-16 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-12 sm:mb-16">
        <!-- Telegram - Primary -->
        <AnimatedSection client:visible animation="fadeUp" delay={0}>
          <Card className="text-center hover:shadow-lg transition-shadow duration-300 h-full border-2 border-primary" client:idle>
            <CardContent className="p-6" client:idle>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <Send className="w-8 h-8 text-primary" client:idle />
              </div>
              <h3 class="text-lg font-heading font-bold text-gray-800 mb-1.5">
                Telegram
              </h3>
              <p class="text-xs font-paragraph text-gray-500 mb-2">
                {t.contact.telegramDesc}
              </p>
              <a
                href="https://t.me/AnnaZakernichnaia"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block"
                aria-label={t.contact.messageOnTelegram}
              >
                <Button size="sm" className="bg-primary hover:bg-primary/90 text-white" client:idle>
                  {t.contact.messageOnTelegram}
                </Button>
              </a>
            </CardContent>
          </Card>
        </AnimatedSection>

        <!-- WhatsApp - Alternative Primary -->
        <AnimatedSection client:visible animation="fadeUp" delay={0.1}>
          <Card className="text-center hover:shadow-lg transition-shadow duration-300 h-full" client:idle>
            <CardContent className="p-6" client:idle>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <MessageCircle className="w-8 h-8 text-primary" client:idle />
              </div>
              <h3 class="text-lg font-heading font-bold text-gray-800 mb-1.5">
                WhatsApp
              </h3>
              <p class="text-xs font-paragraph text-gray-500 mb-2">
                {t.contact.whatsappDesc}
              </p>
              <a
                href="https://wa.me/79267291313"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block"
                aria-label={t.contact.messageOnWhatsapp}
              >
                <Button size="sm" variant="outline" className="border-primary text-primary hover:bg-primary/5" client:idle>
                  {t.contact.messageOnWhatsapp}
                </Button>
              </a>
            </CardContent>
          </Card>
        </AnimatedSection>

        <!-- Instagram -->
        <AnimatedSection client:visible animation="fadeUp" delay={0.2}>
          <Card className="text-center hover:shadow-lg transition-shadow duration-300 h-full" client:idle>
            <CardContent className="p-6" client:idle>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <Camera className="w-8 h-8 text-primary" client:idle />
              </div>
              <h3 class="text-lg font-heading font-bold text-gray-800 mb-1.5">
                Instagram
              </h3>
              <p class="text-xs font-paragraph text-gray-500 mb-2">
                {t.contact.instagramDesc}
              </p>
              <a
                href="https://www.instagram.com/annabody.studio"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block"
                aria-label={t.contact.followOnInstagram}
              >
                <Button size="sm" variant="outline" className="border-primary text-primary hover:bg-primary/5" client:idle>
                  {t.contact.followOnInstagram}
                </Button>
              </a>
            </CardContent>
          </Card>
        </AnimatedSection>

        <!-- Email - Last Resort -->
        <AnimatedSection client:visible animation="fadeUp" delay={0.3}>
          <Card className="text-center hover:shadow-lg transition-shadow duration-300 h-full" client:idle>
            <CardContent className="p-6" client:idle>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                <Mail className="w-8 h-8 text-primary" client:idle />
              </div>
              <h3 class="text-lg font-heading font-bold text-gray-800 mb-1.5">
                Email
              </h3>
              <p class="text-xs font-paragraph text-gray-500 mb-2">
                {t.contact.emailDesc}
              </p>
              <a
                href="mailto:ann.massage@icloud.com"
                class="inline-block"
                aria-label={t.contact.sendEmail}
              >
                <Button size="sm" variant="outline" className="border-primary text-primary hover:bg-primary/5" client:idle>
                  {t.contact.sendEmail}
                </Button>
              </a>
            </CardContent>
          </Card>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="py-12 sm:py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Contact Information -->
        <AnimatedSection client:visible animation="fadeUp">
          <Card className="h-full" client:idle>
            <CardHeader client:idle>
              <CardTitle className="text-2xl font-heading font-bold text-gray-800" client:idle>
                {t.contact.contactInformation}
              </CardTitle>
            </CardHeader>
            <CardContent className="space-y-6" client:idle>
              <div class="flex items-start gap-4">
                <MapPin className="w-6 h-6 text-primary mt-1 flex-shrink-0" client:idle />
                <div>
                  <h4 class="font-heading font-semibold text-gray-800 mb-1">{t.contact.location}</h4>
                  <p class="font-paragraph text-blue-gray">
                    {t.contact.locationValue}
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <MessageCircle className="w-6 h-6 text-primary mt-1 flex-shrink-0" client:idle />
                <div>
                  <h4 class="font-heading font-semibold text-gray-800 mb-1">WhatsApp</h4>
                  <p class="font-paragraph text-blue-gray">{t.contact.phoneValue}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <Send className="w-6 h-6 text-primary mt-1 flex-shrink-0" client:idle />
                <div>
                  <h4 class="font-heading font-semibold text-gray-800 mb-1">Telegram</h4>
                  <p class="font-paragraph text-blue-gray">@AnnaZakernichnaia</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <Mail className="w-6 h-6 text-primary mt-1 flex-shrink-0" client:idle />
                <div>
                  <h4 class="font-heading font-semibold text-gray-800 mb-1">{t.contact.emailLabel}</h4>
                  <p class="font-paragraph text-blue-gray">{t.contact.emailValue}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <Clock className="w-6 h-6 text-primary mt-1 flex-shrink-0" client:idle />
                <div>
                  <h4 class="font-heading font-semibold text-gray-800 mb-1">{t.contact.responseTime}</h4>
                  <p class="font-paragraph text-blue-gray">
                    {t.contact.responseTimeValue}<br />
                    <span class="text-sm">{t.contact.emergencyConsultations}</span>
                  </p>
                </div>
              </div>
            </CardContent>
          </Card>
        </AnimatedSection>

        <!-- Movement Studio -->
        <AnimatedSection client:visible animation="fadeUp" delay={0.1}>
          <Card className="h-full" client:idle>
            <CardContent className="p-0" client:idle>
              <img
                src="/images/contact/recovery-studio.webp"
                alt="Private practice space in Limassol, Cyprus"
                width="600"
                class="w-full h-64 object-cover rounded-t-lg select-none"
                loading="lazy"
                decoding="async"
              />
              <div class="p-6">
                <h4 class="text-2xl font-heading font-bold text-gray-800 mb-4">
                  {t.contact.recoveryStudio}
                </h4>
                <p class="font-paragraph text-blue-gray">
                  {t.contact.recoveryStudioDesc}
                </p>
              </div>
            </CardContent>
          </Card>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection client:visible animation="fadeUp">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-4 sm:mb-6 leading-tight">
            {t.contact.faqTitle}
          </h2>
          <p class="text-base sm:text-lg font-paragraph text-blue-gray max-w-3xl mx-auto px-4 leading-relaxed">
            {t.contact.faqSubtitle}
          </p>
        </div>
      </AnimatedSection>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 max-w-6xl mx-auto">
        {faqs.map((faq, index) => (
          <AnimatedSection client:visible animation="fadeUp" delay={index * 0.1}>
            <Card client:idle>
              <CardContent className="p-6" client:idle>
                <h4 class="font-heading font-semibold text-gray-800 mb-3">
                  {faq.question}
                </h4>
                <p class="font-paragraph text-blue-gray leading-relaxed">
                  {faq.answer}
                </p>
              </CardContent>
            </Card>
          </AnimatedSection>
        ))}
      </div>
    </div>
  </section>
</div>
