---
import { getLocaleFromUrl, getTranslations, getLocalizedPath } from '@/lib/i18n';
import { AnimatedSection } from '@/components/ui/AnimatedSection';
import { Button } from '@/components/ui/button';
import { Card, CardContent } from '@/components/ui/card';
import { Heart, Target, Users } from 'lucide-react';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
---

<div class="min-h-screen bg-white overflow-x-hidden">
  <!-- Header -->
  <section class="py-16 sm:py-20 md:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection client:visible animation="fadeUp">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-gray-800 mb-4 sm:mb-6 leading-tight">
            {t.about.title}
          </h1>
          <p class="text-base sm:text-lg md:text-xl font-paragraph text-blue-gray max-w-3xl mx-auto px-4 leading-relaxed">
            {t.about.subtitle}
          </p>
        </div>
      </AnimatedSection>
    </div>
  </section>

  <!-- Main About Section -->
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center mb-12 sm:mb-16 md:mb-20">
        <AnimatedSection client:visible animation="fadeLeft">
          <img
            src="/images/about/about_job.webp"
            alt="Anna Z. - Professional movement coaching session"
            width="600"
            class="w-full h-96 object-cover rounded-lg select-none"
            loading="lazy"
            decoding="async"
          />
        </AnimatedSection>

        <AnimatedSection client:visible animation="fadeRight">
          <div class="text-center lg:text-left">
            <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-6 leading-tight">
              {t.about.partnerInRecovery}
            </h2>
            <p class="text-base sm:text-lg font-paragraph text-blue-gray mb-6 leading-relaxed">
              {t.about.aboutText1}
            </p>
            <p class="text-base sm:text-lg font-paragraph text-blue-gray mb-6 leading-relaxed">
              {t.about.aboutText2}
            </p>
            <p class="text-base sm:text-lg font-paragraph text-blue-gray mb-8 leading-relaxed">
              {t.about.aboutText3}
            </p>
            <a href={getLocalizedPath('/contact', locale)} aria-label="Start your journey">
              <Button className="bg-primary hover:bg-primary/90 text-primary-foreground px-8 py-3" client:idle>
                {t.about.startYourJourney}
              </Button>
            </a>
          </div>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- Philosophy Section -->
  <section class="py-12 sm:py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection client:visible animation="fadeUp">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-4 sm:mb-6 leading-tight">
            {t.about.myPhilosophy}
          </h2>
          <p class="text-base sm:text-lg md:text-xl font-paragraph text-blue-gray max-w-3xl mx-auto px-4 leading-relaxed">
            {t.about.philosophySubtitle}
          </p>
        </div>
      </AnimatedSection>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <AnimatedSection client:visible animation="fadeUp" delay={0}>
          <Card className="h-full text-center hover:shadow-lg transition-shadow duration-300" client:idle>
            <CardContent className="p-6 sm:p-8" client:idle>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 sm:mb-6">
                <Target className="w-8 h-8 text-primary" client:idle />
              </div>
              <h3 class="text-xl sm:text-2xl font-heading font-bold text-gray-800 mb-3 sm:mb-4">
                {t.about.functionalMovement}
              </h3>
              <p class="text-sm sm:text-base font-paragraph text-blue-gray leading-relaxed">
                {t.about.functionalMovementDesc}
              </p>
            </CardContent>
          </Card>
        </AnimatedSection>

        <AnimatedSection client:visible animation="fadeUp" delay={0.1}>
          <Card className="h-full text-center hover:shadow-lg transition-shadow duration-300" client:idle>
            <CardContent className="p-6 sm:p-8" client:idle>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 sm:mb-6">
                <Users className="w-8 h-8 text-primary" client:idle />
              </div>
              <h3 class="text-xl sm:text-2xl font-heading font-bold text-gray-800 mb-3 sm:mb-4">
                {t.about.postureReeducation}
              </h3>
              <p class="text-sm sm:text-base font-paragraph text-blue-gray leading-relaxed">
                {t.about.postureReeducationDesc}
              </p>
            </CardContent>
          </Card>
        </AnimatedSection>

        <AnimatedSection client:visible animation="fadeUp" delay={0.2}>
          <Card className="h-full text-center hover:shadow-lg transition-shadow duration-300" client:idle>
            <CardContent className="p-6 sm:p-8" client:idle>
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 sm:mb-6">
                <Heart className="w-8 h-8 text-primary" client:idle />
              </div>
              <h3 class="text-xl sm:text-2xl font-heading font-bold text-gray-800 mb-3 sm:mb-4">
                {t.about.mobilityWork}
              </h3>
              <p class="text-sm sm:text-base font-paragraph text-blue-gray leading-relaxed">
                {t.about.mobilityWorkDesc}
              </p>
            </CardContent>
          </Card>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- Credentials Section -->
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection client:visible animation="fadeUp">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-4 sm:mb-6 leading-tight">
            {t.about.qualifications}
          </h2>
          <p class="text-base sm:text-lg font-paragraph text-blue-gray max-w-3xl mx-auto px-4 leading-relaxed">
            {t.about.qualificationsSubtitle}
          </p>
        </div>
      </AnimatedSection>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        <AnimatedSection client:visible animation="fadeUp" delay={0}>
          <div class="text-center group cursor-default">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary/20 transition-colors duration-300">
              <Users className="w-8 h-8 text-primary" client:idle />
            </div>
            <h3 class="text-lg sm:text-xl font-heading font-bold text-gray-800 mb-2 sm:mb-3">
              {t.about.experienceYears}
            </h3>
            <p class="text-sm sm:text-base font-paragraph text-blue-gray">
              {t.about.experienceYearsDesc}
            </p>
          </div>
        </AnimatedSection>

        <AnimatedSection client:visible animation="fadeUp" delay={0.1}>
          <div class="text-center group cursor-default">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary/20 transition-colors duration-300">
              <Target className="w-8 h-8 text-primary" client:idle />
            </div>
            <h3 class="text-lg sm:text-xl font-heading font-bold text-gray-800 mb-2 sm:mb-3">
              {t.about.continuingEducation}
            </h3>
            <p class="text-sm sm:text-base font-paragraph text-blue-gray">
              {t.about.continuingEducationDesc}
            </p>
          </div>
        </AnimatedSection>

        <AnimatedSection client:visible animation="fadeUp" delay={0.2}>
          <div class="text-center group cursor-default">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary/20 transition-colors duration-300">
              <Heart className="w-8 h-8 text-primary" client:idle />
            </div>
            <h3 class="text-lg sm:text-xl font-heading font-bold text-gray-800 mb-2 sm:mb-3">
              {t.about.holisticApproach}
            </h3>
            <p class="text-sm sm:text-base font-paragraph text-blue-gray">
              {t.about.holisticApproachDesc}
            </p>
          </div>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- Personal Touch Section -->
  <section class="py-12 sm:py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <AnimatedSection client:visible animation="fadeLeft">
          <div class="text-center lg:text-left">
            <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-4 sm:mb-6 leading-tight">
              {t.about.beyondClinic}
            </h2>
            <p class="text-base sm:text-lg font-paragraph text-blue-gray mb-4 sm:mb-6 leading-relaxed">
              {t.about.beyondClinicText1}
            </p>
            <p class="text-base sm:text-lg font-paragraph text-blue-gray mb-4 sm:mb-6 leading-relaxed">
              {t.about.beyondClinicText2}
            </p>
            <p class="text-base sm:text-lg font-paragraph text-blue-gray mb-6 sm:mb-8 leading-relaxed">
              {t.about.beyondClinicText3}
            </p>
          </div>
        </AnimatedSection>

        <AnimatedSection client:visible animation="fadeRight">
          <div class="relative">
            <img
              src="/images/about/about_hobby.webp"
              alt="Anna Z. - Personal portrait in natural setting"
              width="600"
              class="w-full h-96 object-cover rounded-lg select-none"
              loading="lazy"
              decoding="async"
            />
          </div>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 sm:py-16 md:py-24 bg-primary">
    <div class="container mx-auto px-4 sm:px-6 text-center max-w-7xl">
      <AnimatedSection client:visible animation="fadeUp">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6 leading-tight">
          {t.about.readyToTransform}
        </h2>
        <p class="text-lg sm:text-xl font-paragraph text-white mb-8 max-w-2xl mx-auto leading-relaxed">
          {t.about.readyToTransformSubtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={getLocalizedPath('/contact', locale)} class="w-full sm:w-auto" aria-label="Book a session">
            <Button
              size="lg"
              variant="outline"
              className="border-white text-white hover:bg-white hover:text-primary px-8 py-4 text-base sm:text-lg font-medium w-full"
              client:idle
            >
              {t.about.bookSession}
            </Button>
          </a>
          <a href={getLocalizedPath('/services', locale)} class="w-full sm:w-auto" aria-label="View programs">
            <Button
              size="lg"
              variant="outline"
              className="border-white text-white hover:bg-white hover:text-primary px-8 py-4 text-base sm:text-lg font-medium w-full"
              client:idle
            >
              {t.about.viewPrograms}
            </Button>
          </a>
        </div>
      </AnimatedSection>
    </div>
  </section>
</div>
