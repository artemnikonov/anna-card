---
import PageHero from '@/components/PageHero.astro';
import CtaSection from '@/components/CtaSection.astro';
import { getLocaleFromUrl, getTranslations, getLocalizedPath } from '@/lib/i18n';
import AnimatedSection from '@/components/ui/AnimatedSection.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { CircleCheck, Clock, MessageCircle } from '@lucide/astro';
import { bookingLink } from '@/lib/contacts';
import programsData from '@/data/programs.json';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

// Get programs for the current locale
const programs = programsData[locale];
---

<div class="min-h-screen bg-white overflow-x-hidden">
  <PageHero title={t.services.title} subtitle={t.services.subtitle} />

  <!-- Session length and price: both depend on the client, so no fixed numbers -->
  <div class="container mx-auto px-4 sm:px-6 max-w-7xl -mt-6 sm:-mt-10 pb-8 sm:pb-12">
    <ul class="flex flex-col sm:flex-row sm:flex-wrap justify-center gap-3 sm:gap-8 text-center font-paragraph text-gray-700">
      <li class="flex items-center justify-center gap-2"><Clock class="w-5 h-5 text-primary" aria-hidden="true" />{t.services.sessionLength}</li>
      <li class="flex items-center justify-center gap-2">
        <MessageCircle class="w-5 h-5 text-primary" aria-hidden="true" />
        <a {...bookingLink(locale)} class="underline underline-offset-4 hover:text-primary">{t.services.priceOnRequest}</a>
      </li>
    </ul>
  </div>

  <!-- Programs Grid -->
  <section class="py-12 sm:py-16 md:py-24 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 md:gap-12">
        {programs.map((program, index) => (
          <AnimatedSection animation="fadeUp" delay={index * 0.1}>
            <div class={cn("rounded-xl border border-foreground/10 text-foreground bg-background", "h-full hover:shadow-xl transition-all duration-300 border border-gray-200 hover:border-primary/30")}>
              <div class="relative">
                <img
                  src={program.programImage}
                  style={'imagePosition' in program ? `object-position:${program.imagePosition}` : undefined}
                  alt={program.programName || 'Program'}
                  width="600"
                  class="w-full h-80 sm:h-96 object-cover rounded-t-lg select-none"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="flex flex-col space-y-1.5 p-6">
                <h2 class={cn("font-semibold text-lg leading-none tracking-tight", "text-2xl font-heading font-bold text-gray-800")}>
                  {program.programName}
                </h2>
                <p class="font-paragraph text-blue-gray">
                  {program.shortDescription}
                </p>
              </div>

              <div class={cn("p-6 pt-0", "space-y-6")}>
                <p class="font-paragraph text-gray-700 leading-relaxed">
                  {program.fullDescription}
                </p>

                {program.keyBenefits && (
                  <div>
                    <h3 class="font-heading font-semibold text-gray-800 mb-3">{t.services.keyBenefits}</h3>
                    <div class="flex flex-wrap gap-2">
                      {program.keyBenefits.split(',').map((benefit) => (
                        <div class="flex items-center gap-2">
                          <CircleCheck class="w-4 h-4 text-primary" />
                          <span class="font-paragraph text-sm text-gray-700">
                            {benefit.trim()}
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </AnimatedSection>
        ))}
      </div>
    </div>
  </section>

  <!-- Personalized Approach CTA -->
  <section class="py-16 sm:py-20 md:py-24 bg-linear-to-b from-gray-50 to-white border-t border-gray-100">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection animation="fadeUp">
        <div class="text-center max-w-4xl mx-auto">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-bold text-gray-800 mb-6 leading-tight">
            {t.services.personalizedApproach}
          </h2>
          <p class="text-base sm:text-lg font-paragraph text-blue-gray mb-8 leading-relaxed">
            {t.services.personalizedApproachDesc}
          </p>
          <a href={getLocalizedPath('/methodology', locale)} class={cn(buttonVariants({ size: 'lg' }), 'bg-primary hover:bg-primary/90 text-white font-heading')}>{t.services.learnMoreMethodology}</a>
        </div>
      </AnimatedSection>
    </div>
  </section>

  <!-- CTA Section -->
  <CtaSection
    title={t.services.getStarted}
    subtitle={t.services.getStartedSubtitle}
    bookLabel={t.services.scheduleConsultation}
    secondary={{ href: getLocalizedPath('/methodology', locale), label: t.nav.methodology }}
  />
</div>
