---
import { cn } from '@/lib/utils';
import PageHero from '@/components/PageHero.astro';
import CtaSection from '@/components/CtaSection.astro';
import { getLocaleFromUrl, getTranslations, getLocalizedPath } from '@/lib/i18n';
import AnimatedSection from '@/components/ui/AnimatedSection.astro';
import { Activity, Hand, Search, Target, TrendingUp, CircleCheck, Clock, Users } from '@lucide/astro';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

const m = t.methodology;
const steps = [
  { title: m.step1Title, desc: m.step1Desc, items: m.step1Items, icon: Search, img: '/images/methodology/assessment.webp', alt: t.images.assessment },
  { title: m.step2Title, desc: m.step2Desc, items: m.step2Items, icon: Hand, img: '/images/methodology/hands-on.webp', alt: t.images.massage, pos: '50% 0%' },
  { title: m.step3Title, desc: m.step3Desc, items: m.step3Items, icon: Activity, img: '/images/methodology/monitoring.webp', alt: t.images.monitoring },
  { title: m.step4Title, desc: m.step4Desc, items: m.step4Items, icon: TrendingUp, img: '/images/methodology/planning.webp', alt: t.images.planning },
];

const whyItWorksItems = [
  { title: t.methodology.individualized, description: t.methodology.individualizedDesc },
  { title: t.methodology.comprehensive, description: t.methodology.comprehensiveDesc },
  { title: t.methodology.progressive, description: t.methodology.progressiveDesc }
];
---

<div class="min-h-screen bg-white overflow-x-hidden">
  <PageHero title={t.methodology.title} subtitle={t.methodology.subtitle} />

  <!-- Method Overview -->
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-center mb-12 md:mb-20">
        <AnimatedSection animation="fadeLeft">
          <h2 class="text-4xl font-heading font-bold text-gray-800 mb-6">
            {t.methodology.evidenceBased}
          </h2>
          <p class="text-lg font-paragraph text-blue-gray mb-6 leading-relaxed">
            {t.methodology.evidenceBasedDesc}
          </p>
          <p class="text-lg font-paragraph text-blue-gray mb-6 leading-relaxed">
            {t.methodology.evidenceBasedDesc2}
          </p>
          <p class="text-lg font-paragraph text-blue-gray mb-8 leading-relaxed">
            {t.methodology.evidenceBasedDesc3}
          </p>
        </AnimatedSection>

        <AnimatedSection animation="fadeRight">
          <img
            src="/images/methodology/overview.webp"
            alt={t.images.methodologyOverview}
            width="600"
            class="w-full h-96 object-cover rounded-lg shadow-lg select-none"
            loading="lazy"
            decoding="async"
          />
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="py-12 sm:py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection animation="fadeUp">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-6">
            {t.methodology.ourApproach}
          </h2>
          <p class="text-base sm:text-lg font-paragraph text-blue-gray max-w-3xl mx-auto">
            {t.methodology.ourApproachSubtitle}
          </p>
        </div>
      </AnimatedSection>

      <ol class="space-y-12 sm:space-y-16 md:space-y-20">
        {steps.map((step, i) => (
          <li>
            <AnimatedSection>
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
                <div class:list={[i % 2 === 1 && 'lg:order-2']}>
                  <div class="flex items-center mb-6">
                    <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mr-4">
                      <span class="text-2xl font-heading font-bold text-white">{String(i + 1).padStart(2, '0')}</span>
                    </div>
                    <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
                      <step.icon class="w-8 h-8 text-primary" />
                    </div>
                  </div>
                  <h3 class="text-3xl font-heading font-bold text-gray-800 mb-6">{step.title}</h3>
                  <p class="text-lg font-paragraph text-blue-gray mb-6 leading-relaxed">{step.desc}</p>
                  <ul class="space-y-3">
                    {step.items.map((item) => (
                      <li class="flex items-center gap-3">
                        <CircleCheck class="w-5 h-5 text-primary shrink-0" />
                        <span class="font-paragraph text-gray-700">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <img
                  src={step.img}
                  alt={step.alt}
                  style={step.pos && `object-position:${step.pos}`}
                  width="600"
                  class:list={['w-full h-80 object-cover rounded-lg shadow-lg select-none', i % 2 === 1 && 'lg:order-1']}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </AnimatedSection>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Why This Works -->
  <section class="py-12 sm:py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection animation="fadeUp">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-6 leading-tight">
            {t.methodology.whyItWorks}
          </h2>
          <p class="text-base sm:text-lg font-paragraph text-blue-gray max-w-3xl mx-auto leading-relaxed">
            {t.methodology.whyItWorksSubtitle}
          </p>
        </div>
      </AnimatedSection>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {whyItWorksItems.map((item, index) => (
          <AnimatedSection animation="fadeUp" delay={index * 0.1}>
            <div class={cn("rounded-xl border border-foreground/10 text-foreground bg-background", "h-full text-center")}>
              <div class={cn("p-6 pt-0", "p-6 sm:p-8")}>
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6">
                  {index === 0 && <Users class="w-8 h-8 text-primary" />}
                  {index === 1 && <Target class="w-8 h-8 text-primary" />}
                  {index === 2 && <Clock class="w-8 h-8 text-primary" />}
                </div>
                <h3 class="text-2xl font-heading font-semibold text-gray-800 mb-4">
                  {item.title}
                </h3>
                <p class="font-paragraph text-blue-gray leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          </AnimatedSection>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CtaSection
    glow
    title={t.methodology.startToday}
    subtitle={t.methodology.startTodaySubtitle}
    bookLabel={t.homepage.bookSession}
    secondary={{ href: getLocalizedPath('/services', locale), label: t.nav.services }}
  />
</div>
