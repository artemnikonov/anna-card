---
import CtaSection from '@/components/CtaSection.astro';
import { getLocaleFromUrl, getTranslations, getLocalizedPath } from '@/lib/i18n';
import AnimatedSection from '@/components/ui/AnimatedSection.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { bookingLink } from '@/lib/contacts';
import { CircleCheck, Languages, MapPin, Quote, Users, TrendingUp } from '@lucide/astro';
import testimonialsData from '@/data/testimonials.json';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const highlights = testimonialsData.highlights[locale];

const services = [
  { title: t.homepage.postureCorrection, description: t.homepage.postureCorrectionDesc },
  { title: t.homepage.deskWorkerRecovery, description: t.homepage.deskWorkerRecoveryDesc },
  { title: t.homepage.mobilityRestoration, description: t.homepage.mobilityRestorationDesc },
  { title: t.homepage.tensionCoaching, description: t.homepage.tensionCoachingDesc }
];
---

<div class="min-h-screen bg-white overflow-x-hidden">
  <!-- Hero: text left, Anna at work right -->
  <section class="bg-linear-to-b from-gray-50 to-white">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl py-12 sm:py-16 lg:py-24 grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-7 text-left">
        <div class="hero-in">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold text-gray-800 leading-[1.05] tracking-tight text-balance mb-6">
            {t.homepage.heroTitle}
          </h1>
        </div>
        <div class="hero-in" style="--reveal-delay:0.2s">
          <p class="text-lg sm:text-xl font-paragraph text-blue-gray max-w-xl mb-8 leading-relaxed">
            {t.homepage.heroSubtitle}
          </p>
        </div>
        <div class="hero-in flex flex-col sm:flex-row gap-3 sm:gap-4" style="--reveal-delay:0.4s">
          <a {...bookingLink(locale)} class={cn(buttonVariants({ size: 'lg' }), 'glow px-8 py-3 sm:py-4 text-base sm:text-lg font-medium w-full sm:w-auto')}>{t.homepage.bookSession}</a>
          <a href={getLocalizedPath('/about', locale)} class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'border-primary text-primary hover:bg-primary/5 px-8 py-3 sm:py-4 text-base sm:text-lg font-medium w-full sm:w-auto')}>{t.homepage.learnMore}</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <img
          src="/images/about/about_job.webp"
          width="1200"
          height="1800"
          loading="eager"
          fetchpriority="high"
          class="w-full aspect-[4/5] object-cover object-[50%_20%] rounded-2xl select-none"
          alt={t.images.heroPhoto}
        />
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="py-12 sm:py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 sm:gap-6 md:gap-8">
        <AnimatedSection animation="fadeUp" delay={0}>
          <div class="text-center group cursor-default">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary/20 transition-colors duration-300">
              <Users class="w-8 h-8 text-primary" />
            </div>
            <p class="text-3xl font-heading font-bold text-gray-800 mb-2" data-count>1000+</p>
            <p class="font-paragraph text-blue-gray">{t.homepage.clientsHelped}</p>
          </div>
        </AnimatedSection>

        <AnimatedSection animation="fadeUp" delay={0.1}>
          <div class="text-center group cursor-default">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary/20 transition-colors duration-300">
              <TrendingUp class="w-8 h-8 text-primary" />
            </div>
            <p class="text-3xl font-heading font-bold text-gray-800 mb-2" data-count>9+</p>
            <p class="font-paragraph text-blue-gray">{t.homepage.yearsExperience}</p>
          </div>
        </AnimatedSection>

        <AnimatedSection animation="fadeUp" delay={0.3}>
          <div class="text-center group cursor-default">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary/20 transition-colors duration-300">
              <Languages class="w-8 h-8 text-primary" />
            </div>
            <p class="text-3xl font-heading font-bold text-gray-800 mb-2">{t.homepage.statLanguagesValue}</p>
            <p class="font-paragraph text-blue-gray">{t.homepage.statLanguagesLabel}</p>
          </div>
        </AnimatedSection>

        <AnimatedSection animation="fadeUp" delay={0.4}>
          <div class="text-center group cursor-default">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary/20 transition-colors duration-300">
              <MapPin class="w-8 h-8 text-primary" />
            </div>
            <p class="text-3xl font-heading font-bold text-gray-800 mb-2">{t.homepage.statFormatValue}</p>
            <p class="font-paragraph text-blue-gray">{t.homepage.statFormatLabel}</p>
          </div>
        </AnimatedSection>

        <AnimatedSection animation="fadeUp" delay={0.5} class="col-span-2 lg:col-span-1">
          <div class="text-center group cursor-default">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary/20 transition-colors duration-300">
              <CircleCheck class="w-8 h-8 text-primary" />
            </div>
            <p class="text-3xl font-heading font-bold text-gray-800 mb-2" data-count>100%</p>
            <p class="font-paragraph text-blue-gray">{t.homepage.personalized}</p>
          </div>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="py-12 sm:py-16 md:py-24 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <AnimatedSection animation="fadeLeft">
          <div class="text-center lg:text-left">
            <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-6 leading-snug">
              {t.homepage.meetAnna}
            </h2>
            <p class="text-base sm:text-lg font-paragraph text-blue-gray mb-6 leading-relaxed">
              {t.homepage.aboutAnnaText1}
            </p>
            <p class="text-base sm:text-lg font-paragraph text-blue-gray mb-8 leading-relaxed">
              {t.homepage.aboutAnnaText2}
            </p>
            <a href={getLocalizedPath('/about', locale)} class={cn(buttonVariants({ variant: 'outline' }), 'border-primary text-primary hover:bg-primary/5')}>{t.homepage.learnMoreAboutAnna}</a>
          </div>
        </AnimatedSection>

        <AnimatedSection animation="fadeRight">
          <div class="relative">
            <div class="relative overflow-hidden rounded-2xl">
              <img
                src="/images/home/portrait.webp"
                alt={t.images.portrait}
                width="600"
                class="w-full h-96 object-cover select-none"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/10 to-transparent"></div>
            </div>
          </div>
        </AnimatedSection>
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="py-12 sm:py-16 md:py-24 bg-linear-to-b from-gray-50 to-white border-t border-gray-100">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection animation="fadeUp">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-6 leading-tight">
            {t.homepage.specializedPrograms}
          </h2>
          <p class="text-base sm:text-lg font-paragraph text-blue-gray max-w-3xl mx-auto leading-relaxed">
            {t.homepage.specializedProgramsSubtitle}
          </p>
        </div>
      </AnimatedSection>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        {services.map((service, index) => (
          <AnimatedSection animation="fadeUp" delay={index * 0.1}>
            <div class={cn("rounded-xl border border-foreground/10 text-foreground bg-background", "h-full hover:shadow-2xl transition-all duration-300 group border border-gray-200 hover:border-primary/30 bg-white")}>
              <div class={cn("p-6 pt-0", "p-5 sm:p-6 text-center")}>
                <h3 class="text-lg sm:text-xl font-heading font-bold text-gray-800 mb-3 group-hover:text-primary transition-colors duration-300 leading-tight">
                  {service.title}
                </h3>
                <p class="font-paragraph text-sm sm:text-base text-blue-gray leading-relaxed">
                  {service.description}
                </p>
              </div>
            </div>
          </AnimatedSection>
        ))}
      </div>

      <AnimatedSection animation="fadeUp" delay={0.4}>
        <div class="text-center mt-12">
          <a href={getLocalizedPath('/services', locale)} class={cn(buttonVariants(), 'bg-primary hover:bg-primary/90 text-primary-foreground px-8 py-3')}>{t.homepage.viewAllPrograms}</a>
        </div>
      </AnimatedSection>
    </div>
  </section>

  <!-- Testimonials Preview -->
  <section class="py-12 sm:py-16 md:py-24 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
      <AnimatedSection>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-gray-800 mb-10 sm:mb-12 text-center leading-tight">{t.homepage.clientsSay}</h2>
      </AnimatedSection>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {highlights.map((h, index) => (
          <AnimatedSection delay={index * 0.1}>
            <figure class="h-full bg-white rounded-xl border border-gray-200 p-6 sm:p-8 flex flex-col">
              <Quote class="w-8 h-8 text-primary/40 mb-4" aria-hidden="true" />
              <blockquote class="font-paragraph text-gray-700 leading-relaxed flex-1">{h.quote}</blockquote>
              <figcaption class="mt-6 font-heading font-bold text-gray-800">{h.clientName}</figcaption>
            </figure>
          </AnimatedSection>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={getLocalizedPath('/testimonials', locale)} class="font-paragraph text-primary underline underline-offset-4 hover:text-primary/80">{t.homepage.allTestimonials}</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CtaSection
    title={t.homepage.readyToStart}
    subtitle={t.homepage.readyToStartSubtitle}
    bookLabel={t.homepage.bookYourSession}
  />
</div>

