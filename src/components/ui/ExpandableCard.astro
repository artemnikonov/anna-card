---
// Testimonial card: long text is clamped with a "Read more" toggle.
// Without JS the full text is shown and the toggle is hidden.
import { ChevronDown, Quote } from '@lucide/astro';

interface Props {
  id: string;
  clientName: string;
  testimonialText: string;
  readMoreText: string;
  showLessText: string;
}
const { id, clientName, testimonialText, readMoreText, showLessText } = Astro.props;
const long = testimonialText.length > 420;
const paragraphs = testimonialText.split(/\n+/);
---

<article
  data-expandable
  data-collapsed={long ? '' : undefined}
  class="relative group rounded-2xl border border-gray-100 bg-white/90 shadow-xs hover:shadow-xl hover:-translate-y-0.5 transition-all duration-500"
>
  <div class="absolute top-0 left-0 w-1 h-full bg-linear-to-b from-primary to-primary/60 opacity-80 rounded-l-2xl"></div>
  <div class="relative p-6 sm:p-8">
    <div class="flex items-start gap-4 mb-4">
      <div class="flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
        <Quote class="w-6 h-6" aria-hidden="true" />
      </div>
      <div class="flex-1">
        <h2 class="font-heading font-semibold text-lg sm:text-xl text-gray-900 mb-1 scroll-mt-36">{clientName}</h2>
        <div class="h-0.5 w-14 bg-primary/50 rounded-full"></div>
      </div>
    </div>

    <div id={`testimonial-text-${id}`} class="clamp relative overflow-hidden">
      <div class="font-paragraph text-gray-700/95 leading-relaxed text-[15px] sm:text-[16px]">
        {paragraphs.map((p) => <p class="mb-3 last:mb-0">{p}</p>)}
      </div>
      <div class="fade hidden absolute bottom-0 left-0 w-full h-16 bg-linear-to-t from-white to-transparent pointer-events-none"></div>
    </div>

    {long && (
      <div class="toggle mt-4 pt-3 border-t border-gray-100">
        <button
          type="button"
          aria-expanded="false"
          aria-controls={`testimonial-text-${id}`}
          class="inline-flex items-center gap-1.5 text-primary hover:text-primary/80 transition-colors text-sm font-semibold"
        >
          <span class="more">{readMoreText}</span>
          <span class="less">{showLessText}</span>
          <ChevronDown class="chevron w-4 h-4 transition-transform" aria-hidden="true" />
        </button>
      </div>
    )}
  </div>
</article>

<style>
  .less { display: none; }
  article:not([data-collapsed]) .more { display: none; }
  article:not([data-collapsed]) .less { display: inline; }
  article:not([data-collapsed]) .chevron { transform: rotate(180deg); }
  .chevron { transition: transform 0.3s; }
  .toggle button { transition: transform 0.2s, color 0.15s; }
  .toggle button:hover { transform: scale(1.03); }
  .toggle button:active { transform: scale(0.96); }
  @media (scripting: enabled) {
    .clamp { transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
    .fade { display: block; transition: opacity 0.3s; }
    article:not([data-collapsed]) .fade { opacity: 0; }
    article[data-collapsed] .clamp { max-height: 160px; }
  }
  @media (scripting: none) {
    .toggle { display: none; }
  }
</style>

<script>
  // Measure after Montserrat loads: the fallback font is shorter and could hide the toggle wrongly
  document.addEventListener('astro:page-load', () => document.fonts.ready.then(() => document.querySelectorAll<HTMLElement>('[data-expandable]').forEach((card) => {
    const button = card.querySelector('button');
    const clamp = card.querySelector<HTMLElement>('.clamp')!;
    if (!button) return;
    // Text is short enough after all: show it whole
    if (clamp.scrollHeight <= clamp.clientHeight + 40) {
      card.removeAttribute('data-collapsed');
      button.parentElement!.remove();
      return;
    }
    // Once open, drop the fixed height so text can reflow on resize
    clamp.addEventListener('transitionend', (e) => {
      if (e.target === clamp && !card.hasAttribute('data-collapsed')) clamp.style.maxHeight = '';
    });
    button.addEventListener('click', () => {
      const collapse = !card.hasAttribute('data-collapsed');
      // Animate between 160px and the real text height (max-height: none can't transition)
      clamp.style.maxHeight = clamp.scrollHeight + 'px';
      if (collapse) {
        clamp.offsetHeight; // apply the start height before animating down
        clamp.style.maxHeight = '160px';
      }
      card.toggleAttribute('data-collapsed', collapse);
      button.setAttribute('aria-expanded', String(!collapse));
      // After collapsing, bring the card start back into view if it is under the fixed header (80px)
      if (collapse && card.getBoundingClientRect().top < 96) {
        card.querySelector('h2')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  })));
</script>
