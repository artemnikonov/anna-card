---
import AnimatedSection from '@/components/ui/AnimatedSection.astro';

interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---
<section class="py-16 sm:py-20 md:py-24 bg-linear-to-b from-gray-50 to-white">
  <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
    <AnimatedSection>
      <div class="text-center">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-gray-800 mb-4 sm:mb-6 leading-tight">{title}</h1>
        <p class="text-base sm:text-lg md:text-xl font-paragraph text-blue-gray max-w-3xl mx-auto px-4 leading-relaxed">{subtitle}</p>
      </div>
    </AnimatedSection>
  </div>
</section>
